<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="RegistrationDemo.SiteMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Event Registration</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 30px;
        }

        .registration-box {
            width: 500px;
            margin: 0 auto;
            background-color: white;
            padding: 25px;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

        h2 {
            margin-top: 0;
            text-align: center;
        }

        .form-row {
            margin-bottom: 14px;
        }

        .form-row label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        input[type="text"],
        input[type="email"],
        textarea,
        select {
            width: 100%;
            box-sizing: border-box;
            padding: 7px;
        }

        textarea {
            height: 80px;
        }

        .register-button {
            padding: 8px 20px;
            cursor: pointer;
        }

        .message {
            margin-top: 15px;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>

    </form>
</body>
</html>
