<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Product Catalog</title>

    <link href="@Url.Content("~/Content/Site.css")"
          rel="stylesheet"
          type="text/css" />
</head>

<body>

    <nav class="navbar">
        <div class="container">

            @Html.ActionLink(
                "Product Catalog",
                "Index",
                "Product",
                new { area = "" },
                new { @class = "navbar-brand" }
            )

            <div class="navbar-links">

                @Html.ActionLink(
                    "Products",
                    "Index",
                    "Product",
                    new { area = "" },
                    new { @class = "nav-link" }
                )

                @Html.ActionLink(
                    "Add Product",
                    "Create",
                    "Product",
                    new { area = "" },
                    new { @class = "nav-link" }
                )

            </div>

        </div>
    </nav>

    <div class="container body-content">

        @RenderBody()

        <hr />

        <footer>
            <p>
                &copy; @DateTime.Now.Year - Product Catalog
            </p>
        </footer>

    </div>

    @RenderSection("scripts", required: false)

</body>
</html>
